[Unit]
Description=CardputerZero USB keyboard+mouse gadget
After=sys-kernel-config.mount
Wants=sys-kernel-config.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/jiggler/setup-hid-gadget.sh
ExecStop=/usr/lib/jiggler/setup-hid-gadget.sh --remove

[Install]
WantedBy=multi-user.target
