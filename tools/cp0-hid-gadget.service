[Unit]
Description=CardputerZero USB keyboard+mouse gadget
After=sys-kernel-config.mount
Wants=sys-kernel-config.mount

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=APP_USER=intgus
ExecStart=/usr/local/sbin/setup-hid-gadget.sh
ExecStop=/usr/local/sbin/setup-hid-gadget.sh --remove

[Install]
WantedBy=multi-user.target
